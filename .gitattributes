# Normaliza los finales de línea: LF en el repo, nativo en el working tree.
# Evita diffs fantasma al clonar desde otra máquina o al buildear en Vercel.
* text=auto eol=lf

# Binarios: nunca tocar.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
*.xlsx binary

# Archivos generados: no ensucian los diffs de las PRs.
package-lock.json -diff linguist-generated
