# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# pwa (service worker generado por @ducanh2912/next-pwa)
/public/sw.js
/public/sw.js.map
/public/swe-worker-*.js
/public/workbox-*.js
/public/workbox-*.js.map
# El worker propio (worker/index.js) compilado y con hash en el nombre.
/public/worker-*.js
/public/worker-*.js.map
/public/fallback-*.js

# vercel
.vercel

# worktrees de Claude Code
#
# Cada uno es un checkout completo con su propio .git, así que `git add .` los
# tomaba como repos embebidos y dejaba un gitlink roto en el índice.
#
# Sin barra inicial a propósito: el patrón vale a cualquier profundidad, así
# que también alcanza a un worktree anidado dentro de otro.
#
# Se ignora solo `worktrees/` y no `.claude/` entero, para poder versionar la
# configuración del proyecto (settings.json, skills) si algún día se agrega.
.claude/worktrees/

# typescript
*.tsbuildinfo
next-env.d.ts
